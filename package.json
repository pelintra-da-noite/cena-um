{
  "name": "cena-um",
  "productName": "Cena Um",
  "version": "0.3.0",
  "description": "Cena Um — escrita de guiões para cinema, televisão e teatro",
  "author": "Alexandre Serras",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "pt.cenaum.app",
    "productName": "Cena Um",
    "copyright": "© 2026 Alexandre Serras",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "cena",
        "name": "Guião Cena Um",
        "description": "Guião do Cena Um",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "Cena Um",
      "installerLanguages": [
        "pt_PT"
      ],
      "language": "2070",
      "artifactName": "Cena-Um-${version}-instalador.${ext}",
      "uninstallDisplayName": "Cena Um",
      "include": "build/installer.nsh"
    },
    "publish": null,
    "extraFiles": [
      {
        "from": "TERCEIROS.txt",
        "to": "TERCEIROS.txt"
      }
    ]
  },
  "license": "GPL-3.0-only"
}